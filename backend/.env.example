# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database (leave DATABASE_URL unset to use local SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/travel_expense

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend base URL (used to build invite/verification links)
FRONTEND_BASE_URL=http://localhost:3000

# Email (defaults to console backend -- prints emails to the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@travelexpense.app
